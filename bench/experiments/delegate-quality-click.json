    "const fs=require('fs');let r=[];try{r=fs.readFileSync('{CWD}/.thinker/log.jsonl','utf8').split('\\n').filter(Boolean).map(l=>{try{return JSON.parse(l)}catch{return null}}).filter(x=>x&&x.op==='delegate')}catch{};const f=r.filter(x=>x.fired!==false&&!x.after);process.stdout.write(JSON.stringify({rows:r.length,fired:f.length,kinds:f.map(x=>x.kind),files:f.map(x=>(x.files||[]).join('+')),ignored:r.filter(x=>x.after).length,declined:r.filter(x=>x.fired===false).map(x=>x.declined),firedTokens:f.reduce((a,x)=>a+(Number(x.tokens)||0),0)}))"
   ]
