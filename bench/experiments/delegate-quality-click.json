     }
    ]
   },
   "before": [
    [
     "bash",
     "-c",
     "/opt/homebrew/bin/python3.13 -m venv .venv && .venv/bin/pip install -q -e . pytest"
    ],
    [
     "node",
     "--input-type=module",
