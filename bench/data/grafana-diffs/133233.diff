+			err := StatusErrorFromResponse(nil, transportError)
+
+			var apiStatus apierrors.APIStatus
+			require.ErrorAs(t, err, &apiStatus)
+			require.Equal(t, tc.httpCode, apiStatus.Status().Code)
+		})
+	}
+}
