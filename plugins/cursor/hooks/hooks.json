{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [{ "command": "./bin/prompt.sh", "timeout": 15 }],
    "postToolUse": [{ "command": "./bin/tool.sh", "timeout": 10 }],
    "afterShellExecution": [{ "command": "./bin/tool.sh", "timeout": 10 }],
    "stop": [{ "command": "./bin/stop.sh", "timeout": 10 }],
    "sessionEnd": [{ "command": "./bin/stop.sh", "timeout": 10 }]
  }
}
