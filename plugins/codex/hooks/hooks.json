{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/bin/hook.mjs\" codex prompt --record", "timeout": 15 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/bin/hook.mjs\" codex tool --late --record", "timeout": 10 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/bin/hook.mjs\" codex pre", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/bin/hook.mjs\" codex stop --record", "timeout": 10 }] }]
  }
}
