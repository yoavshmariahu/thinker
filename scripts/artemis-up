#!/usr/bin/env bash
# artemis-up: start Artemis, the evals platform, from this checkout — or, when it is already running,
# say where and open it. The port comes from the machine's port registry (claude-port, label
# "artemis"); the app runs in the foreground, so Ctrl-C stops it.
#
#   artemis-up            start (or open) Artemis
#   artemis-up --no-open  do not open the browser
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PORTS="$HOME/.claude/bin/claude-port"
OPEN=1
ARGS=()
for a in "$@"; do if [ "$a" = "--no-open" ]; then OPEN=0; else ARGS+=("$a"); fi; done

open_url() { if [ "$OPEN" = 1 ] && command -v open >/dev/null; then open "$1"; fi; }

if [ ! -f "$ROOT/bench/evals/server.js" ]; then
  echo "artemis-up: $ROOT has no bench/evals; check out main there (git -C $ROOT checkout main && git -C $ROOT pull)" >&2
  exit 1
fi

# already running: one Artemis per machine, every worktree shares its database. The server holds
# ~/.artemis/artemis.db.server.json while it lives (bench/evals/db.js lockServer) and refuses a second start.
running=$(node -e '
  const f = require("os").homedir() + "/.artemis/artemis.db.server.json";
  try { const s = JSON.parse(require("fs").readFileSync(f, "utf8")); process.kill(s.pid, 0); console.log(s.port); } catch {}
' 2>/dev/null || true)
# a server started before the lock existed shows only as a live reservation
if [ -z "${running:-}" ] && [ -x "$PORTS" ]; then
  running=$("$PORTS" list thinker 2>/dev/null | awk '($3 == "artemis" || $3 == "evals") && $5 == "yes" { print $1; exit }')
fi
if [ -n "${running:-}" ]; then
  echo "Artemis is already running: http://127.0.0.1:$running"
  open_url "http://127.0.0.1:$running"
  exit 0
fi

# one stable port: reuse the registry's artemis reservation while the port is free, drop the rest
if [ -x "$PORTS" ]; then
  PORT=""
  for p in $("$PORTS" list thinker 2>/dev/null | awk '($3 == "artemis" || $3 == "evals") && $5 == "no" { print $1 }'); do
    if [ -z "$PORT" ]; then PORT=$p; else "$PORTS" release thinker "$p" >/dev/null; fi
  done
  [ -n "$PORT" ] || PORT=$("$PORTS" reserve thinker artemis)
else
  PORT="${PORT:-7860}"
fi

# open the page once the app answers
if [ "$OPEN" = 1 ]; then
  ( for _ in $(seq 1 40); do
      curl -sf "http://127.0.0.1:$PORT/api/experiments" -o /dev/null && { open_url "http://127.0.0.1:$PORT"; exit 0; }
      sleep 0.5
    done ) &
fi

cd "$ROOT"
exec env THINKER_TEST=1 PORT="$PORT" node bench/evals/server.js --port "$PORT" ${ARGS[@]+"${ARGS[@]}"}
