{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "thinker hook prompt --client devin --record",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "thinker hook tool --client devin --late --record",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "thinker hook stop --client devin --record",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "thinker hook stop --client devin --record",
          "timeout": 10
        }
      ]
    }
  ]
}
